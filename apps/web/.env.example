# Environment for apps/web. Copy to apps/web/.env.local for local development
# (Next reads it), or run `vercel env pull apps/web/.env.local` from the repo root.
# src/env.ts is the source of truth for these names; test/env.test.ts fails if a
# variable there is missing here. Per-environment values: docs/setup.md (H4).

# Required. Signs cookies and encrypts stored OAuth tokens. At least 32 characters;
# generate with `openssl rand -base64 32`. Use a different value in every environment.
BETTER_AUTH_SECRET=

# Optional. The production origin, such as https://hive-mind.example. Production only;
# leave unset locally. Without it, deployments use Vercel's VERCEL_PROJECT_PRODUCTION_URL.
# BETTER_AUTH_URL=

# Required. Pooled Postgres URL used at runtime. On Vercel the Neon integration sets it.
# Locally, the Postgres from the root compose.yaml:
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Direct (unpooled) Postgres URL, read only by the migrator (packages/db). Required in
# every Vercel environment; the Neon integration sets it. `pnpm db:migrate` does not
# read this file, so pass the variable on the command line (see README.md).
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Required. GitHub OAuth app credentials. Locally and in Development, use the dev OAuth
# app (callback http://localhost:3000/api/auth/callback/github). Production and Preview
# both use the production OAuth app, because previews sign in through production.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required. Encrypts what oAuthProxy passes between production and preview deployments.
# At least 32 characters (`openssl rand -base64 32`). Must be the same value in
# Production and Preview. Locally any 32+ character value works.
OAUTH_PROXY_SECRET=

# Vercel system variables. Vercel sets these on deployments; leave them unset locally.
# VERCEL_ENV=
# VERCEL_PROJECT_PRODUCTION_URL=
# VERCEL_URL=
# VERCEL_BRANCH_URL=

# Tests only. Not read from this file: export it in the shell that runs `pnpm test`.
# Without it, database tests are skipped locally (and fail in CI).
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
