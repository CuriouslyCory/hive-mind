{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["VERCEL_ENV"],
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "OAUTH_PROXY_SECRET",
        "CRON_SECRET",
        "VERCEL_*"
      ]
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "//#lint:root": {},
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["CI", "TEST_DATABASE_URL"]
    },
    "test:e2e": {
      "dependsOn": ["transit", "@hivemind/cli#build"],
      "cache": false,
      "env": ["CI", "TEST_DATABASE_URL", "E2E_SERVER"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "OAUTH_PROXY_SECRET",
        "CRON_SECRET"
      ]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL_UNPOOLED"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL_UNPOOLED"]
    }
  }
}
